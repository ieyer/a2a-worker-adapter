# Identity
A2A_WORKER_ID=worker-a
A2A_AGENT_NAME=worker-a A2A Runtime Adapter

# Public A2A server
A2A_HOST=127.0.0.1
A2A_PORT=8000
A2A_AGENT_URL=https://your-public-host.example/
A2A_BEARER_TOKEN=replace-with-a-long-random-secret
A2A_ALLOW_UNAUTHENTICATED=false
A2A_IDEMPOTENCY_DB=./data/a2a-idempotency.sqlite3
A2A_MAX_MESSAGE_BYTES=262144

# Real worker wake bridge: command | http | spool
WORKER_WAKE_MODE=disabled
WORKER_WAKE_TIMEOUT=300

# command mode: fixed executable, task JSON on stdin, result JSON on stdout.
WORKER_WAKE_COMMAND=

# http mode: loopback-only by default.
WORKER_WAKE_URL=
WORKER_WAKE_TOKEN=
WORKER_WAKE_ALLOW_REMOTE_HTTP=false

# spool mode: requires a separate zero-token local consumer.
WORKER_SPOOL_DIR=./spool

# Optional event hooks module (dotted module name or path to a .py file).
# See hooks.py and examples/example_hooks.py. Leave empty to disable.
HOOKS_MODULE=
